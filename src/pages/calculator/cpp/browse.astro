---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SALARIES } from '../../../data/seo-scenarios';
import { TAX_YEAR_CONFIG } from '../../../config/taxYears.js';

const { CURRENT_APP_YEAR } = TAX_YEAR_CONFIG;

export const prerender = true;

const title = `[${CURRENT_APP_YEAR}] Browse CPP Benefits by Age and Salary | LoonieFi`;
const description = `Compare Canada Pension Plan (CPP) retirement benefits across different retirement ages and income levels for ${CURRENT_APP_YEAR}.`;
const canonicalURL = new URL('/calculator/cpp/browse', Astro.site || Astro.url.origin);

const AGES = [60, 65, 70];
const formatter = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <main class="bg-slate-50 min-h-screen">
    <section class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <header class="mb-16 text-center animate-fade-in">
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tight">
          Browse <span class="text-indigo-600">CPP Benefit</span> Scenarios
        </h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto font-medium">
          Select a retirement age to see how your average career salary impacts your expected Canada Pension Plan payouts.
        </p>
      </header>
    
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-fade-in" style="animation-delay: 100ms;">
        {AGES.map((age) => (
          <article class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm hover:shadow-xl hover:border-indigo-200 transition-all group">
            <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center justify-between">
              Age {age}
              <span class="text-xs bg-slate-100 text-slate-400 py-1 px-3 rounded-full font-bold uppercase tracking-widest group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                {age === 60 ? 'Early' : age === 65 ? 'Standard' : 'Deferred'}
              </span>
            </h2>
            
            <div class="grid grid-cols-2 gap-2">
              {SALARIES.slice(0, 10).map((salary) => (
                <a 
                  href={`/calculator/cpp/${age}/${salary}/`} 
                  class="text-xs bg-slate-50 hover:bg-indigo-600 text-slate-600 hover:text-white px-3 py-3 rounded-xl border border-slate-100 font-black text-center transition-all transform hover:-translate-y-1"
                >
                  {formatter.format(salary)}
                </a>
              ))}
            </div>
            
            <div class="mt-8 pt-6 border-t border-slate-50">
                <a href={`/cpp-oas-calculator/`} class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600 hover:text-indigo-800 transition-colors">
                    Custom Calculator →
                </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
