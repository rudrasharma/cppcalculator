---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MortgageCalculator from '../../../../features/mortgage/components/MortgageCalculator.jsx';
import Breadcrumbs from '../../../../components/shared/Breadcrumbs.astro';
import { PROVINCES as PROVINCE_LIST, HOME_PRICES } from '../../../../data/seo-scenarios.js';
import { calculateAmortization } from '../../../../features/mortgage/utils/mortgageEngine.js';
import { calculateLTT, PROVINCES } from '../../../../features/mortgage/utils/lttEngine.js';

export const prerender = true;

export function getStaticPaths() {
    let paths = [];
    PROVINCE_LIST.forEach((prov, pIndex) => {
        HOME_PRICES.forEach((price, iIndex) => {
            
            // Get next and previous for interlinking
            const nextPrice = iIndex < HOME_PRICES.length - 1 ? HOME_PRICES[iIndex + 1] : null;
            const prevPrice = iIndex > 0 ? HOME_PRICES[iIndex - 1] : null;

            paths.push({
                params: {
                    province: prov.slug,
                    price: price.toString()
                },
                props: {
                    prov,
                    price,
                    nextPrice,
                    prevPrice
                }
            });
        });
    });
    return paths;
}

const { prov, price, nextPrice, prevPrice } = Astro.props;
const safeProvince = prov.code;

const initialStateOverride = {
    calculationMode: 'purchase',
    homePrice: price,
    downPayment: Math.max(price * 0.05, Math.min(price * 0.20, price - 500000)), // dynamic down payment logic to ensure validity
    annualRate: 5.0,
    amortizationYears: 25,
    paymentFrequency: 'monthly',
    province: safeProvince,
    isToronto: false,
    isFirstTimeBuyer: false,
    showStressTest: false
};

// SERVER SIDE MATH FOR SEO INJECTIONS
const serverResults = calculateAmortization({
    homePrice: price,
    downPayment: initialStateOverride.downPayment,
    annualRate: 5.0,
    amortizationYears: 25,
    paymentFrequency: 'monthly',
    isRenewal: false,
    province: safeProvince
});

const lttResults = calculateLTT(price, safeProvince, false, false);

const formatter = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
const monthlyPaymentStr = formatter.format(serverResults.monthlyPayment);
const totalInterestStr = formatter.format(serverResults.totalInterest);
const homePriceStr = formatter.format(price);
const lttStr = formatter.format(lttResults.totalTax);
const provinceName = PROVINCES[safeProvince];

const label = `${provinceName} Mortgage Calculator`;
const desc = `Calculate exact mortgage payments, CMHC insurance, and Land Transfer Taxes for a ${homePriceStr} home in ${provinceName}. Monthly payments estimated at ${monthlyPaymentStr}.`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const breadcrumbPath = [
  { label: 'Mortgage', href: '/mortgage-calculator/' },
  { label: 'Scenarios', href: '/calculator/mortgage/browse/' },
  { label: `${homePriceStr} in ${prov.code}`, href: Astro.url.pathname }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `${label} - ${homePriceStr}`,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "CAD"
  },
  "description": desc
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How much is the mortgage on a ${homePriceStr} house in ${provinceName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Assuming a standard 5% interest rate and 25-year amortization, the monthly mortgage payment on a ${homePriceStr} home in ${provinceName} is approximately ${monthlyPaymentStr}, plus ${lttStr} in Land Transfer Taxes.`
      }
    }
  ]
};

---

<BaseLayout 
    title={`Mortgage Payments on a ${homePriceStr} Home in ${provinceName} | LoonieFi`} 
    description={desc}
    canonicalURL={canonicalURL}
>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <main class="bg-slate-50 min-h-screen pb-16">
        
        <div class="bg-white border-b border-slate-200">
            <div class="max-w-6xl mx-auto px-4 py-8">
                <Breadcrumbs crumbs={breadcrumbPath} />
                
                <div class="mt-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div class="max-w-2xl">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-xs font-black tracking-widest uppercase border border-indigo-100">
                                {prov.code}
                            </span>
                            <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Mortgage Estimate</span>
                        </div>
                        <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">
                            Payments for a <span class="text-indigo-600">{homePriceStr}</span> Home in {provinceName}
                        </h1>
                        <p class="text-lg text-slate-600 font-medium leading-relaxed">
                            {desc}
                        </p>
                    </div>

                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 min-w-[280px]">
                        <div class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-2">Monthly Payment</div>
                        <div class="text-4xl font-black text-slate-900">{monthlyPaymentStr}</div>
                        <div class="mt-4 pt-4 border-t border-slate-200">
                            <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Land Transfer Tax</div>
                            <div class="text-lg font-black text-slate-700">{lttStr}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- The React Calculator Client Component -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <MortgageCalculator client:load initialState={initialStateOverride} />
        </div>

        <!-- Spiderweb Interlinking for SEO -->
        <nav class="max-w-6xl mx-auto px-4 mt-8" aria-label="Related scenarios">
            <h2 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">Explore other price points in {prov.name}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {prevPrice && (
                    <a 
                        href={`/calculator/mortgage/${prov.slug}/${prevPrice}/`}
                        class="flex items-center p-4 bg-white border border-slate-200 rounded-2xl hover:border-indigo-300 hover:shadow-md transition-all group"
                    >
                        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </div>
                        <div class="ml-4">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Previous</div>
                            <div class="text-lg font-black text-slate-900 group-hover:text-indigo-600 transition-colors">{formatter.format(prevPrice)}</div>
                        </div>
                    </a>
                )}
                
                {nextPrice && (
                    <a 
                        href={`/calculator/mortgage/${prov.slug}/${nextPrice}/`}
                        class="flex items-center justify-end p-4 bg-white border border-slate-200 rounded-2xl hover:border-indigo-300 hover:shadow-md transition-all group text-right"
                    >
                        <div class="mr-4">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Next</div>
                            <div class="text-lg font-black text-slate-900 group-hover:text-indigo-600 transition-colors">{formatter.format(nextPrice)}</div>
                        </div>
                        <div class="flex-shrink-0 w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </div>
                    </a>
                )}
            </div>
        </nav>

    </main>
</BaseLayout>
