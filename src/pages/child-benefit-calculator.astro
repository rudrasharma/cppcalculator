---
export const prerender = true;

/**
 * Child Benefit Calculator Page
 * Main page for the Canada Child Benefit calculator
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import HouseholdBenefits from '../features/child-benefit/components/HouseholdBenefits.jsx';
import TrustBadge from '../components/shared/TrustBadge.astro';
import { TAX_YEAR_CONFIG } from '../config/taxYears.js';
const { CURRENT_APP_YEAR, CCB } = TAX_YEAR_CONFIG;

interface Props {}

const title = `Canada Child Benefit (CCB) Calculator [${CURRENT_APP_YEAR}] | Free Estimator`;
const description = `Calculate your exact ${CURRENT_APP_YEAR} Canada Child Benefit (CCB) payments. Fast, free estimator for Canadian families based on AFNI, child age brackets, and tax year.`;
const canonicalURL = new URL('/child-benefit-calculator/', Astro.site || Astro.url.origin);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "description": description,
  "url": canonicalURL.toString(),
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "CAD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the maximum CCB amount for ${CURRENT_APP_YEAR}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `For the ${CURRENT_APP_YEAR} benefit year, the maximum Canada Child Benefit is $${CCB.MAX_UNDER_6.toLocaleString()} per year ($${(CCB.MAX_UNDER_6 / 12).toFixed(2)}/mo) for each child under 6, and $${CCB.MAX_6_TO_17.toLocaleString()} per year ($${(CCB.MAX_6_TO_17 / 12).toFixed(2)}/mo) for each child aged 6 to 17.`
      }
    },
    {
      "@type": "Question",
      "name": "What is the CCB income threshold for 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The first income threshold for CCB phase-out in 2026 is $${CCB.THRESHOLD_1.toLocaleString()}. Families with an Adjusted Family Net Income (AFNI) below this amount receive the maximum benefit.`
      }
    }
  ]
};
---

<BaseLayout 
  title={title} 
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  {/* TITLE SECTION with Trust Badge */}
  <header class="max-w-6xl mx-auto px-4 pt-8 text-center md:text-left animate-fade-in">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2 justify-center md:justify-start">
          Household Benefits Estimator [{CURRENT_APP_YEAR}]
        </h1>
        <p class="text-slate-500 text-sm font-medium">
          CCB, Trillium, Carbon Rebate & GST Credits
        </p>
      </div>

      {/* TRUST BADGE SPECIFIC TO CCB DATA */}
      <div class="mb-4 flex justify-center md:justify-start">
          <TrustBadge dateStr={`July ${CURRENT_APP_YEAR}`} sourceStr="CRA Indexed Rates" />
      </div>
    </div>
  </header>

  {/* REACT COMPONENT */}
  <main class="flex-grow flex flex-col justify-center w-full animate-fade-in">
    <HouseholdBenefits client:only="react" isVisible={true} />
  </main>

  {/* pSEO LINK SECTION */}
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-4 text-center">
    <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6">
      <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Looking for specific family examples?</p>
      <a 
        href="/calculator/child-benefit/browse/" 
        class="inline-flex items-center gap-2 text-sm font-bold text-emerald-600 hover:text-emerald-700 transition-colors hover:underline"
        aria-label="Browse child benefit examples by province and family size"
      >
        Browse Benefits by Province & Family Size
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* SEO CONTENT SECTION */}
  <section class="max-w-4xl mx-auto px-6 py-12 text-slate-700 leading-relaxed text-sm">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight mb-4">
          How Much is the Canada Child Benefit (CCB) in {CURRENT_APP_YEAR}?
        </h2>
        <p class="text-base text-slate-600 leading-relaxed mb-6">
          For the {CURRENT_APP_YEAR} benefit year, the maximum Canada Child Benefit (CCB) is <strong>${CCB.MAX_UNDER_6.toLocaleString()} per year (${(CCB.MAX_UNDER_6 / 12).toFixed(2)}/month)</strong> for each eligible child under age 6, and <strong>${CCB.MAX_6_TO_17.toLocaleString()} per year (${(CCB.MAX_6_TO_17 / 12).toFixed(2)}/month)</strong> for each child aged 6 to 17. Benefit amounts begin phasing out when your Adjusted Family Net Income (AFNI) exceeds ${CCB.THRESHOLD_1.toLocaleString()}.
        </p>

        <div class="overflow-x-auto rounded-2xl border border-slate-100 bg-slate-50 mb-8">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-100 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
              <tr>
                <th class="p-3">Child Age Bracket</th>
                <th class="p-3">Max Annual Benefit</th>
                <th class="p-3">Max Monthly Cheque</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="p-3 font-bold text-slate-900">Under 6 Years Old</td>
                <td class="p-3 font-semibold text-emerald-600">${CCB.MAX_UNDER_6.toLocaleString()}</td>
                <td class="p-3 font-semibold">${(CCB.MAX_UNDER_6 / 12).toFixed(2)}</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-900">Ages 6 to 17 Years Old</td>
                <td class="p-3 font-semibold text-slate-700">${CCB.MAX_6_TO_17.toLocaleString()}</td>
                <td class="p-3 font-semibold">${(CCB.MAX_6_TO_17 / 12).toFixed(2)}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
        <div class="space-y-2">
          <h3 class="text-base font-bold text-slate-900">When Do CCB Payments Recalculate?</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            The CCB is recalculated every July based on your family's prior-year tax return. For example, payments starting in <strong>July {CURRENT_APP_YEAR}</strong> are calculated using your <strong>{parseInt(CURRENT_APP_YEAR) - 1} Tax Return</strong> filed with the CRA.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-base font-bold text-slate-900">What is the Phase-Out Threshold?</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            Families with an Adjusted Family Net Income (AFNI) below <strong>${CCB.THRESHOLD_1.toLocaleString()}</strong> receive the maximum payment. Above this threshold, benefits are gradually reduced based on family income and the number of qualifying children.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
