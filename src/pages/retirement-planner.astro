---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RetirementPlanner } from '../features/retirement-planner/components';
import TrustBadge from '../components/shared/TrustBadge.astro';
import { TAX_YEAR_CONFIG } from '../config/taxYears.js';

const { CURRENT_APP_YEAR } = TAX_YEAR_CONFIG;

export const prerender = true;

const title = `[${CURRENT_APP_YEAR}] Retirement Planner & Drawdown Calculator | LoonieFi`;
const description = `Plan your Canadian retirement with our free drawdown calculator. Estimate how long your RRSP, TFSA, CPP, OAS, and pensions will last based on your target income in ${CURRENT_APP_YEAR}.`;
const canonicalURL = new URL('/retirement-planner/', Astro.site || Astro.url.origin);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "description": description,
  "url": canonicalURL.toString(),
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "CAD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much do I need to retire in Canada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The amount you need to retire in Canada depends entirely on your target lifestyle and retirement age. A common rule of thumb is aiming for 70% of your pre-retirement income. Using our Retirement Planner, you can input your specific expenses, government benefits (like CPP and OAS), and current portfolio to see exactly how long your money will last."
      }
    },
    {
      "@type": "Question",
      "name": "Does this calculator include CPP and OAS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Our Retirement Planner automatically estimates your Canada Pension Plan (CPP) and Old Age Security (OAS) payouts based on your income and retirement age. It factors these government benefits into your overall cash flow so you know exactly how much you need to withdraw from your own savings each year."
      }
    }
  ]
};
---

<BaseLayout canonicalURL={canonicalURL} title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    
    <main class="w-full">
        <header class="max-w-6xl mx-auto px-4 pt-8 pb-4 text-center md:text-left animate-fade-in">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
              <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-2">
                Retirement Planner [{CURRENT_APP_YEAR}]
              </h1>
              <p class="text-slate-500 text-sm font-medium">
                Drawdown calculator for RRSP, TFSA, CPP, and OAS
              </p>
            </div>
            <div class="flex justify-center md:justify-start">
                <TrustBadge dateStr={CURRENT_APP_YEAR.toString()} sourceStr="CRA Contribution Limits" />
            </div>
          </div>
        </header>

        <RetirementPlanner client:load />

        <section class="max-w-6xl mx-auto px-4 py-12">
            <div class="p-6 bg-indigo-50 rounded-2xl border border-indigo-100 max-w-3xl">
                <h3 class="text-indigo-900 font-bold mb-2">Explore Retirement Scenarios</h3>
                <p class="text-indigo-700 mb-4 text-sm">Curious about retiring early or delaying until 70? Browse our pre-calculated retirement drawdown scenarios to see how your target income affects your longevity.</p>
                <a href="/calculator/retirement/browse/" class="inline-block bg-indigo-600 text-white px-4 py-2 rounded-xl font-bold text-xs hover:bg-indigo-700 transition-colors">
                    Browse Retirement Scenarios &rarr;
                </a>
            </div>
        </section>
    </main>
</BaseLayout>
