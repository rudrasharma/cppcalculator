---
/**
 * CAGR Calculator Page
 * Main page for the Compound Annual Growth Rate calculator
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import CAGRCalculator from '../features/cagr/components/CAGRCalculator.jsx';
import TrustBadge from '../components/shared/TrustBadge.astro';
import { TAX_YEAR_CONFIG } from '../config/taxYears.js';

const { CURRENT_APP_YEAR } = TAX_YEAR_CONFIG;

const title = `[${CURRENT_APP_YEAR}] CAGR Calculator | Compound Annual Growth Rate`;
const description = `Calculate the precise annual growth rate required to grow your investment from a starting value to an ending value over a specific period.`;
---

<BaseLayout 
  title={title} 
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a good CAGR for investments?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A good Compound Annual Growth Rate (CAGR) depends on the asset class. Historically, a diversified stock market index like the S&P 500 has returned around 7% to 10% annually after inflation."
        }
      }
    ]
  })} />
  
  {/* TITLE SECTION */}
  <header class="max-w-6xl mx-auto px-4 pt-8 text-center md:text-left animate-fade-in">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div>
        <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-2 flex items-center justify-center md:justify-start">
          CAGR Calculator [{CURRENT_APP_YEAR}]
        </h1>
        <p class="text-slate-500 text-sm font-medium">
          Measure the consistent growth rate of your investments
        </p>
      </div>

      {/* OPTIONAL: Trust Badge */}
      <div class="mb-4 flex justify-center md:justify-start">
          <TrustBadge dateStr={CURRENT_APP_YEAR.toString()} sourceStr="Standard Financial Formula" />
      </div>
    </div>
  </header>

  {/* REACT COMPONENT */}
  <main class="flex-grow flex flex-col justify-center w-full animate-fade-in">
    <CAGRCalculator client:load isVisible={true} />
  </main>

  {/* SEO CONTENT SECTION */}
  <section class="max-w-3xl mx-auto px-6 py-12 text-slate-600 leading-relaxed text-sm">
    <h2 class="text-lg font-bold text-slate-900 mb-4">What is CAGR?</h2>
    <p class="mb-4">
      The <strong>Compound Annual Growth Rate (CAGR)</strong> is one of the most accurate ways to calculate and determine returns for anything that can rise or fall in value over time.
    </p>
    <p>
      Unlike a simple average return, CAGR smoothes out the volatility of investment returns. It represents the rate at which an investment would have grown if it had grown the same rate every single year and the profits were reinvested at the end of each year.
    </p>
  </section>

</BaseLayout>